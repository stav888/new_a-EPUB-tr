<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/popup_background"
    android:padding="8dp"
    android:elevation="8dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:minWidth="240dp">

        <TextView
            android:id="@+id/copyTextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Copy Text"
            android:textSize="15sp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/purple_200"
            android:layout_marginVertical="8dp" />

        <TextView
            android:id="@+id/translateHereButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Translate"
            android:textSize="15sp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/purple_200"
        android:layout_marginVertical="4dp" />

    <TextView
        android:id="@+id/translateDialogButton"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:text="Translation popup"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/purple_200"
        android:layout_marginVertical="4dp" />

    <!-- Open in Google Translate -->
    <TextView
        android:id="@+id/googleTranslateButton"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:text="Open in Google Translate"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/googleTranslateBubble"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:text="Google Bubble"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <!-- Open in Yandex Translate -->
    <TextView
        android:id="@+id/yandexTranslateButton"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:text="Open in Yandex Translate"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/yandexTranslateBubble"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:text="Yandex Bubble"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
