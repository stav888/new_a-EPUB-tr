# JetBrains Rendering Fix Options
# Disable hardware acceleration to fix rendering issues
-Dsun.java2d.d3d=false
-Dsun.java2d.opengl=false
-Dsun.java2d.metal=false

# Force software rendering
-Dsun.java2d.noddraw=true
-Dsun.java2d.pmoffscreen=false

# Fix text rendering issues
-Dawt.useSystemAAFontSettings=lcd
-Dswing.aatext=true

# Disable problematic graphics features
-Dsun.java2d.xrender=false
-Dsun.java2d.uiScale.enabled=false

# Memory and GC optimizations
-Xms512m
-Xmx2048m
-XX:ReservedCodeCacheSize=512m
-XX:+UseConcMarkSweepGC
-XX:SoftRefLRUPolicyMSPerMB=50

# Fix for high DPI displays
-Dsun.java2d.win.uiScaleX=1.0
-Dsun.java2d.win.uiScaleY=1.0

# Additional stability fixes
-Djava.net.preferIPv4Stack=true
-Djb.vmOptionsFile=idea.vmoptions
